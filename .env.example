# Copy this file to .env for local dev, and set the same values in Vercel for production.

# From Neon: Dashboard → your project → Connection string (use the "pooled" one)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any long random string — used to encrypt login sessions.
# Generate one at https://generate-secret.vercel.app/32 or run: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Your deployed URL. For local dev, leave as-is.
NEXTAUTH_URL="http://localhost:3000"

# Only used once, when running "npm run seed" to create your first login.
# Not needed after that — safe to remove afterwards.
ADMIN_EMAIL="you@wingfires.com"
ADMIN_PASSWORD="choose-a-strong-password"

# --- One-way connector: reads new quotes from your wingfires.com website ---
# These are the SAME values you already added to your wingfires.com Vercel
# project earlier (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY) — reuse them
# here so this CRM can read (never write) new quote requests.
SOURCE_SUPABASE_URL="https://your-project-ref.supabase.co"
SOURCE_SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Any random string — protects the automatic hourly sync endpoint so only
# Vercel's own scheduler can trigger it. Generate one the same way as
# NEXTAUTH_SECRET above.
CRON_SECRET="replace-with-another-long-random-string"
