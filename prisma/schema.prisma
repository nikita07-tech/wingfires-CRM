// Wing Fires CRM — standalone database schema (Phase 1)
// Customers, RFQs, Quotes, Orders, and Invoices get added here in later phases
// using the same pattern — this keeps things real and working at every step
// instead of generating unused tables up front.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  PROCUREMENT
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(SALES)
  createdAt    DateTime @default(now())

  leadsOwned   Lead[]   @relation("LeadOwner")
  leadsCreated Lead[]   @relation("LeadCreator")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  RFQ_RECEIVED
  QUOTE_SENT
  WON
  LOST
  INACTIVE
}

model Lead {
  id               String     @id @default(cuid())
  leadNumber       String     @unique
  companyName      String
  contactName      String?
  email            String?
  phone            String?
  address          String?
  country          String?
  industry         String?
  aircraftTypes    String?
  interestedParts  String?
  source           String?
  priority         String     @default("medium")
  status           LeadStatus @default(NEW)
  notes            String?
  sourceRfqId      String?    @unique // set when this lead was auto-imported from a website RFQ, prevents duplicate imports

  assignedTo       User?      @relation("LeadOwner", fields: [assignedToId], references: [id])
  assignedToId     String?
  createdBy        User?      @relation("LeadCreator", fields: [createdById], references: [id])
  createdById      String?

  activities       LeadActivity[]

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model LeadActivity {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  action    String   // e.g. "created", "status_changed", "note_added"
  detail    String?
  createdAt DateTime @default(now())
}

// Simple sequence table used to generate LD-00001 style numbers
model NumberingSequence {
  key       String @id  // 'lead'
  prefix    String
  nextValue Int    @default(1)
  padding   Int    @default(5)
}